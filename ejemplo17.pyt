# EJERCICIO 17 - MÉTODOS DE STR EN PYTHON
# Ejemplos de operaciones con cadenas
texto = "Python"
print("Longitud:", len(texto))
print("Mayúsculas:", texto.upper())
print("Minúsculas:", texto.lower())
print("Capitalizar:", texto.capitalize())
print("Título:", texto.title())
print("Primeros caracteres:", texto[:3])
print("Últimos caracteres:", texto[-3:])
print("Comparación:", texto == "Python")
print("Reemplazar:", texto.replace("Python", "Hola Python"))
